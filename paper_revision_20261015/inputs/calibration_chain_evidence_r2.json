  "function_source": "def propagate_gaiacat(tbl, t_target, ref_epoch=2000):\n    # t_target = Time(dateobs, format='isot', scale='utc')\n    # \u8f6c\u6362\u4e3a Julian year (decimal year) \u4fbf\u4e8e\u4e0e proper motion\uff08mas/yr\uff09\u914d\u5408\n    target_epoch = t_target.jyear  # e.g. 2025.303...\n    # \u63d0\u53d6\u5217\u5e76\u8d4b\u4e88\u5355\u4f4d\n    if 'ra_epoch2000' in tbl.colnames:\n        ra = tbl['ra_epoch2000'].astype(float) #* u.deg\n        dec = tbl['dec_epoch2000'].astype(float) #* u.deg\n        pmra = tbl['pmra'].astype(float) #* u.mas/u.yr\n        pmdec = tbl['pmdec'].astype(float) #* u.mas/u.yr\n    else:\n        ra = tbl['ra'].astype(float) * u.deg\n        dec = tbl['dec'].astype(float) * u.deg\n        pmra = tbl['pmra'].astype(float) * u.mas/u.yr\n        pmdec = tbl['pmdec'].astype(float) * u.mas/u.yr\n    if 'ref_epoch' not in tbl.colnames:\n        t_ref = Time(ref_epoch, format='jyear')\n    else:\n        t_ref = Time(tbl['ref_epoch'][0], format='jyear')\n\n    sc_kwargs = dict(frame='icrs', ra=ra, dec=dec)\n    sc_kwargs['pm_ra_cosdec'] = pmra\n    sc_kwargs['pm_dec'] = pmdec\n    sc = SkyCoord(**sc_kwargs, obstime=t_ref)\n    t_tgt = Time(target_epoch, format='jyear')\n    sc_moved = sc.apply_space_motion(new_obstime=t_tgt)\n    ra_tgt = sc_moved.ra.to(u.deg).value\n    dec_tgt = sc_moved.dec.to(u.deg).value\n\n    tbl['X_WORLD'] = ra_tgt\n    tbl['Y_WORLD'] = dec_tgt\n    bad = np.isnan(ra_tgt) |  np.isnan(dec_tgt)\n    tbl['X_WORLD'][bad] = ra[bad]\n    tbl['Y_WORLD'][bad] = dec[bad]",
  "call_chain_sources": {
    "calib_flux.py:gaia_mags": "def gaia_mags(cat, band, obs_region):\n    # get Gaia color-corrected magnitude for specific filter\n    # Change from VEGA MAG to AB MAG\n    cat['phot_g_mean_mag'] = cat['phot_g_mean_mag'] + 0.1136777774\n    cat['phot_bp_mean_mag'] = cat['phot_bp_mean_mag'] + 0.0154133401\n    cat['phot_rp_mean_mag'] = cat['phot_rp_mean_mag'] + 0.3560882381\n    # color transp. parameters\n    filterlist=['u', 'v', 'g', 'r', 'i', 'z', 'y', 'w']\n    ifilt=filterlist.index(band)\n    ffpar=np.array([[-0.12372707, 0.87415984, 2.68152378, 0.46688053],\\\n                    [ 0.0715824, 0.42018862, 1.58311364, 0.30184685],\\\n                    [-0.02193249, 0.22376644, 0.51403047,-0.04977904],\\\n                    [ 0.0850583, 0.0045054, -0.17416451, 0.02696644],\\\n                    [ 0.03638692, 0.0513301, -0.58839035, 0.02328468],\\\n                    [-0.14492398, 0.26053385, -0.82220974, -0.0115362],\\\n                    [-0.27416685, 0.36465315, -0.89341154, -0.02812699],\\\n                    [-0.03971196, 0.19464851, -0.11042587, -0.03542586]])\n    coeff = ffpar[ifilt,:]\n    color_br = cat['bp_rp'] - 0.340674898\n    colorterm = coeff[0] * color_br**3 + coeff[1] * color_br**2 + coeff[2] * color_br + coeff[3]\n    gaia_G = cat['phot_g_mean_mag']\n    mags = gaia_G + colorterm\n    magcut1 = 19.0\n    magcut2 = 12.0 \n\n    #select good phot_mag\n    goodid = (cat['phot_g_n_obs'] > 3) & (cat['phot_bp_n_obs'] > 1) & (cat['phot_rp_n_obs'] > 1)\\\n        & (color_br < 2.5) & (color_br > 0.5) \\\n        & (gaia_G < magcut1) & (gaia_G > magcut2)\\\n        & (cat['ra'] > obs_region[0]) & (cat['ra'] < obs_region[1])\\\n        & (cat['dec'] > obs_region[2]) & (cat['dec'] < obs_region[3]) \n    # print('starGAIA.sum()=', goodid.sum())\n    if goodid.sum() < 20: goodid = list(range(mags.size))\n    mags = mags[goodid]\n    magerr = mags * 0.01\n    ra = cat['ra'][goodid]\n    dec = cat['dec'][goodid]\n    gimedian = np.median(color_br[goodid])\n    refc = SkyCoord(ra, dec, unit=(u.deg, u.deg), frame='icrs')\n    return mags, magerr, gimedian, refc",
    "calib_flux.py:read_gaiacat": "def read_gaiacat(ra, dec, refdir, obstime, silent=True):\n    # function: Read a piece of the GAIA calibration catalog containing ra,dec.\n    c = SkyCoord(ra,dec, unit=(u.deg, u.deg))\n    if isinstance(ra[0], str):\n        c = SkyCoord(ra, dec, unit=(u.hourangle, u.deg))\n    phi = c.ra.deg / (180. / np.pi)\n    theta = (90. - c.dec.deg) / (180 / np.pi)\n    ipring = ang2pix(32, theta, phi)\n    pix = np.unique(ipring)\n    npix = pix.size\n    if npix > 10: \n        print('too many healpix files:', npix, ' check image wcs!')\n        return\n    ps = []\n    for i in pix:\n        fname = refdir + '/healpix-' + '%5.5d'%i + '.fits'\n        if not os.path.isfile(fname):\n            continue\n        if not silent: print(('Reading ', fname))\n        if os.path.isfile(fname):\n            ps.append(table.Table.read(fname))\n    ps = table.vstack(ps)\n    utils.propagate_gaiacat(ps, obstime)\n    print('load gaia stars:', len(ps))\n    return ps",
    "astrometry/cal_pos.py:get_gaiacat": "def get_gaiacat(fits_name, search_radius, path_gaia, output_dir, silent=True, pm_corr=True, pm_zp=2016.0):\n    print('############ gaia reference ############')\n    fits_name_img_new = fits_name.replace('.fits', '_img.new')\n    header1 = fits.getheader(fits_name_img_new, 0)\n    gaialacnm = output_dir + '/' + os.path.basename(fits_name).replace('.fits','_gaia.fits')\n\n    if pm_corr:\n        obstime = Time(header1['DATE-OBS'], format='isot', scale='utc')\n        deltatime = obstime.decimalyear - pm_zp\n        print('(Time - ZeroPoint) = deltatime (yr) = ', deltatime)\n\n    ### convert sky cor to healpy\n    ra = float(header1['CRVAL1'])\n    dec = float(header1['CRVAL2'])\n    c = SkyCoord(ra, dec, unit=(u.deg, u.deg))\n    ra = c.ra.deg\n    dec = c.dec.deg\n    c = SkyCoord(ra, dec, unit=(u.deg, u.deg))\n    phi = c.ra.deg / (180. / np.pi)\n    theta = (90. - c.dec.deg) / (180 / np.pi)\n    vec = hp.ang2vec(theta, phi)\n    list1 = hp.query_disc(nside=32, vec=vec, radius=np.radians(search_radius))\n    if -1 in list1:\n        list1.remove(-1)\n    ipring = np.array(list1)\n    pix = np.unique(ipring)\n    refcat = []\n    for i in pix:\n        fname = os.path.join(path_gaia, 'healpix-' + '%5.5d' % i + '.fits')\n        if not os.path.isfile(fname):\n            continue\n        if not silent:\n            print('i= %5.5d' % i, fname)\n        refcat.append(table.Table.read(fname))\n    refcat = table.vstack(refcat) \n    if len(refcat) == 0: return\n    if 'XK_healpix' in path_gaia: # Using calib catalog from XK\n        refcat.rename_column('g_xpsp', 'MAG')\n    else:\n        refcat.rename_column('phot_g_mean_mag', 'MAG')\n    utils.propagate_gaiacat(refcat, obstime) # add X_WORLD, Y_WORLD in obstime\n\n    mask=(~np.isnan(refcat['X_WORLD']) & (~np.isnan(refcat['Y_WORLD'])) & (refcat['MAG'] > 0))\n    refcat=refcat[mask]\n    print('total gaia sources:',len(refcat))\n    if pm_corr:\n        refcat['ra_error'] = refcat['ra_error'] / 1000.0 / 3600.0\n        refcat['dec_error'] = refcat['dec_error'] / 1000.0 / 3600.0\n        refcat.rename_column('ra_error', 'ERRA_WORLD')\n        refcat.rename_column('dec_error', 'ERRB_WORLD')\n        # refcat.rename_column('pmra','PMALPHA_J2000')\n        # refcat.rename_column('pmdec','PMDELTA_J2000')\n        # refcat.rename_column('pmra_error','PMALPHAERR_J2000')\n        # refcat.rename_column('pmdec_error','PMDELTAERR_J2000')\n\n    hdu = fits.BinTableHDU(refcat)\n    hdu1 = convert_hdu_to_ldac(hdu)\n    thdulist = fits.HDUList([fits.PrimaryHDU(), hdu1[0], hdu1[1]])\n    thdulist.writeto(gaialacnm, overwrite=True)\n    thdulist.close()",
    "astrometry/cal_pos.py:run_scamp": "def run_scamp(fits_name, path_config, output_dir):\n    print('############ run scamp ############')\n    config_scamp = path_config + \"/config.scamp\"\n    fitsname = os.path.basename(fits_name)\n    fp_acat = output_dir + '/' + fitsname.replace(\".fits\",'_sex.fits') \n    fp_ref_cat = output_dir + '/' + fitsname.replace(\".fits\",'_gaia.fits') \n\n    scamp_comd = f'scamp {fp_acat} -ASTREFCAT_NAME {fp_ref_cat} -c {config_scamp}  -CHECKPLOT_TYPE NONE'\n    os.system(scamp_comd)"
  },
